{
  "name": "departure-bay-speedway",
  "version": "1.0.0",
  "description": "GTA-style dirtbike racing game map of Departure Bay, Nanaimo. Map data (c) OpenStreetMap contributors.",
  "type": "module",
  "scripts": {
    "start": "node serve.mjs",
    "serve": "node serve.mjs",
    "bake": "node tools/bake.mjs",
    "voices": "python3 tools/make_voices.py",
    "serve:prod": "node tools/serve-prod.mjs",
    "check:scene": "node tools/check-street.mjs",
    "check:rider": "node tools/check-authored-rider.mjs",
    "check:geography": "node tools/check-geography.mjs",
    "check:characters": "node tools/check-church-character.mjs",
    "check:voices": "node tools/check-dialogue.mjs && node tools/check-dialogue-events.mjs",
    "check:traffic": "node tools/check-reference-vehicles.mjs"
  }
}
